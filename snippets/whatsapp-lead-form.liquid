{%- comment -%}
  WhatsApp enquiry form.

  Every WhatsApp link on the site (wa.me / api.whatsapp.com / whatsapp://) opens
  this form first. It asks for Name, Contact number, Quantity and Time in hand,
  then opens WhatsApp with those details as the first message. The number comes
  from the clicked link, so Meru Gifting pages keep the gifting line.

  Other scripts can open it too:
    window.mtWaForm.open({ phone: '917892207252', text: 'Opening line', qty: 3, buildMessage: fn })
{%- endcomment -%}

<div class="mtwa" id="mtwa" hidden>
  <div class="mtwa__backdrop" data-mtwa-close></div>
  <div class="mtwa__dialog" role="dialog" aria-modal="true" aria-labelledby="mtwa-title">
    <button type="button" class="mtwa__x" data-mtwa-close aria-label="Close">&times;</button>
    <div class="mtwa__head">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="28" height="28" fill="#25D366" aria-hidden="true"><path d="M16 3C9.373 3 4 8.373 4 15c0 2.385.668 4.61 1.832 6.502L4 29l7.701-1.814A11.94 11.94 0 0016 27c6.627 0 12-5.373 12-12S22.627 3 16 3zm0 22a9.95 9.95 0 01-5.078-1.393l-.364-.217-4.573 1.077 1.099-4.461-.237-.376A9.953 9.953 0 016 15c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10zm5.422-7.355c-.297-.148-1.757-.867-2.03-.967-.272-.099-.47-.148-.668.148-.198.297-.767.967-.94 1.166-.173.198-.347.223-.644.074-.297-.148-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.457.13-.605.133-.133.297-.347.446-.52.148-.173.198-.297.297-.495.099-.198.05-.372-.025-.52-.074-.148-.668-1.611-.915-2.207-.241-.579-.486-.5-.668-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.148.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.227 1.36.195 1.872.118.571-.085 1.757-.718 2.006-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
      <div>
        <h2 class="mtwa__title" id="mtwa-title">Chat with us on WhatsApp</h2>
        <p class="mtwa__sub">A few details so we can quote you faster.</p>
      </div>
    </div>
    <form class="mtwa__form" id="mtwa-form" novalidate>
      <label class="mtwa__field">
        <span>Name <em>(optional)</em></span>
        <input type="text" name="name" autocomplete="name" maxlength="80" placeholder="Your name">
      </label>
      <label class="mtwa__field">
        <span>Contact number <b aria-hidden="true">*</b></span>
        <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="20" placeholder="10-digit mobile number">
      </label>
      <div class="mtwa__row">
        <label class="mtwa__field">
          <span>Quantity <em>(optional)</em></span>
          <input type="number" name="qty" inputmode="numeric" min="1" max="100000" step="1" placeholder="e.g. 25">
        </label>
        <label class="mtwa__field">
          <span>Time in hand <em>(optional)</em></span>
          <select name="time">
            <option value="" selected>Select</option>
            <option>Within 2 days (urgent)</option>
            <option>3 to 7 days</option>
            <option>1 to 2 weeks</option>
            <option>More than 2 weeks</option>
            <option>Not sure yet</option>
          </select>
        </label>
      </div>
      <label class="mtwa__field">
        <span>Description <em>(optional)</em></span>
        <textarea name="desc" rows="3" maxlength="1000" placeholder="What do you need? e.g. product, event, engraving text, budget"></textarea>
      </label>
      <p class="mtwa__error" id="mtwa-error" role="alert" hidden></p>
      <button type="submit" class="mtwa__submit">Continue to WhatsApp</button>
    </form>
  </div>
</div>

<style>
  .mtwa[hidden] { display: none !important; }
  .mtwa { position: fixed; inset: 0; z-index: 100000; display: flex; align-items: center; justify-content: center; padding: 16px; font-family: var(--font-body-family, system-ui, sans-serif); }
  .mtwa__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.55); }
  .mtwa__dialog { position: relative; width: 100%; max-width: 420px; max-height: calc(100vh - 32px); overflow-y: auto; background: #fff; color: #1a1a1a; border-radius: 16px; padding: 24px 20px 20px; box-shadow: 0 20px 60px rgba(0,0,0,.3); }
  .mtwa__x { position: absolute; top: 8px; right: 10px; width: 36px; height: 36px; border: 0; background: transparent; font-size: 28px; line-height: 1; color: #666; cursor: pointer; border-radius: 50%; }
  .mtwa__x:hover { background: #f2f2f2; }
  .mtwa__head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 18px; padding-right: 28px; }
  .mtwa__title { margin: 0; font-size: 19px; line-height: 1.3; font-weight: 700; color: #1a1a1a; letter-spacing: 0; font-family: inherit; }
  .mtwa__sub { margin: 4px 0 0; font-size: 14px; line-height: 1.4; color: #555; }
  .mtwa__form { display: flex; flex-direction: column; gap: 12px; }
  .mtwa__row { display: grid; grid-template-columns: 1fr 1.3fr; gap: 12px; }
  .mtwa__field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 600; color: #333; letter-spacing: 0; }
  .mtwa__field em { font-style: normal; font-weight: 400; color: #888; }
  .mtwa__field b { color: #d93025; font-weight: 600; }
  .mtwa__field textarea { width: 100%; box-sizing: border-box; min-height: 84px; padding: 10px 12px; font-size: 16px; line-height: 1.4; font-family: inherit; color: #1a1a1a; background: #fff; border: 1px solid #cfcfcf; border-radius: 10px; outline: none; resize: vertical; }
  .mtwa__field input, .mtwa__field select { width: 100%; box-sizing: border-box; height: 46px; padding: 0 12px; font-size: 16px; font-family: inherit; color: #1a1a1a; background: #fff; border: 1px solid #cfcfcf; border-radius: 10px; outline: none; -webkit-appearance: none; appearance: none; }
  .mtwa__field select { background-image: linear-gradient(45deg, transparent 50%, #666 50%), linear-gradient(135deg, #666 50%, transparent 50%); background-position: calc(100% - 18px) 20px, calc(100% - 13px) 20px; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 30px; }
  .mtwa__field input:focus, .mtwa__field select:focus, .mtwa__field textarea:focus { border-color: #25D366; box-shadow: 0 0 0 3px rgba(37,211,102,.2); }
  .mtwa__field .is-invalid { border-color: #d93025; }
  .mtwa__error { margin: 0; font-size: 13px; color: #d93025; }
  .mtwa__submit { margin-top: 4px; height: 50px; border: 0; border-radius: 25px; background: #25D366; color: #fff; font-size: 16px; font-weight: 700; font-family: inherit; cursor: pointer; letter-spacing: .2px; }
  .mtwa__submit:hover { background: #1ebe5b; }
  @media (max-width: 380px) { .mtwa__row { grid-template-columns: 1fr; } }
  body.mtwa-open { overflow: hidden; }
</style>

<script>
  (function () {
    var root = document.getElementById('mtwa');
    var form = document.getElementById('mtwa-form');
    var errEl = document.getElementById('mtwa-error');
    if (!root || !form) return;
    var DEFAULT_PHONE = '917892207252';
    var F = { name: form.querySelector('[name=name]'), phone: form.querySelector('[name=phone]'), qty: form.querySelector('[name=qty]'), time: form.querySelector('[name=time]'), desc: form.querySelector('[name=desc]') };
    var current = null;
    var lastFocus = null;

    function store(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }

    function parseLink(href) {
      var phone = '', text = '';
      try {
        var u = new URL(href, window.location.href);
        if (/wa\.me$/i.test(u.hostname)) phone = u.pathname.replace(/\D/g, '');
        phone = phone || (u.searchParams.get('phone') || '').replace(/\D/g, '');
        text = u.searchParams.get('text') || '';
      } catch (e) {
        var m = String(href).match(/phone=(\d+)/); if (m) phone = m[1];
      }
      return { phone: phone || DEFAULT_PHONE, text: text };
    }

    function opener(text) {
      var t = (text || '').trim().replace(/\.{2,}$/, '').trim();
      if (!t || /^h(i|ello|ey)[\s!.,]*$/i.test(t)) return 'Hi Meru Trophy, I would like a quote.';
      return t;
    }

    function pageLine() {
      return 'Page: ' + window.location.origin + window.location.pathname;
    }

    function open(opts) {
      current = opts || {};
      lastFocus = document.activeElement;
      errEl.hidden = true;
      form.querySelectorAll('.is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
      if (!F.name.value) F.name.value = store('mtwa_name') || '';
      if (!F.phone.value) F.phone.value = store('mtwa_phone') || '';
      F.qty.value = current.qty ? String(current.qty) : '';
      root.hidden = false;
      document.body.classList.add('mtwa-open');
      var first = !F.phone.value ? F.phone : (!F.name.value ? F.name : F.qty);
      setTimeout(function () { try { first.focus({ preventScroll: true }); } catch (e) { first.focus(); } }, 30);
    }

    function close() {
      root.hidden = true;
      document.body.classList.remove('mtwa-open');
      current = null;
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
    }

    function fail(msg, el) {
      errEl.textContent = msg; errEl.hidden = false;
      if (el) { el.classList.add('is-invalid'); el.focus(); }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      form.querySelectorAll('.is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
      var name = F.name.value.trim();
      var phone = F.phone.value.trim();
      var qty = F.qty.value.trim();
      var time = F.time.value;
      var desc = F.desc.value.trim();
      if (phone.replace(/\D/g, '').length < 10) return fail('Please enter a valid contact number.', F.phone);
      if (name) store('mtwa_name', name);
      store('mtwa_phone', phone);

      // Only the contact number is required; blank optional fields are left out of the message.
      var lines = [];
      if (name) lines.push('Name: ' + name);
      lines.push('Contact number: ' + phone);
      if (qty) lines.push('Quantity: ' + qty);
      if (time) lines.push('Time in hand: ' + time);
      if (desc) lines.push('Description: ' + desc);
      var details = { name: name, phone: phone, qty: qty, time: time, desc: desc, lines: lines };
      var c = current || {};
      var message;
      if (typeof c.buildMessage === 'function') {
        message = c.buildMessage(details);
      } else {
        message = [
          opener(c.text),
          ''
        ].concat(lines).concat(opener(c.text).indexOf(window.location.pathname) > -1 && window.location.pathname !== '/' ? [] : ['', pageLine()]).join('\n');
      }
      var url = 'https://wa.me/' + (c.phone || DEFAULT_PHONE) + '?text=' + encodeURIComponent(message);
      if (window.gtag) {
        window.gtag('event', 'whatsapp_form_submit', { event_category: 'whatsapp', event_label: c.source || window.location.pathname, quantity: parseInt(qty, 10) || 0, time_in_hand: time || 'not given' });
      }
      close();
      var w = window.open(url, '_blank', 'noopener,noreferrer');
      if (!w) window.location.href = url;
    });

    root.addEventListener('click', function (e) { if (e.target.closest('[data-mtwa-close]')) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !root.hidden) close(); });

    // Every WhatsApp link on the page opens the form first.
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest && e.target.closest('a[href]');
      if (!a || root.contains(a)) return;
      var href = a.getAttribute('href') || '';
      if (!/(^|\/\/)(wa\.me|api\.whatsapp\.com|web\.whatsapp\.com)\/|^whatsapp:/i.test(href)) return;
      e.preventDefault();
      var info = parseLink(href);
      open({ phone: info.phone, text: info.text, source: a.getAttribute('data-wa-source') || 'link' });
    }, true);

    window.mtWaForm = { open: open, close: close };
  })();
</script>
