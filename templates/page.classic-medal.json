          "settings": {
            "html": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:ital,wght@0,400;0,500;0,700;1,400&display=swap\">\n<style>\n  :root{\n    --paper:#F4F2EE;\n    --card:#FFFFFF;\n    --ink:#2A2118;\n    --ink-soft:#5C5347;\n    --line:#DDD7CC;\n    --brass:#9A701E;\n    --brass-soft:#F0E6D2;\n    --blue:#2B4C7E;\n    --shadow:0 1px 3px rgba(42,33,24,.08), 0 6px 18px rgba(42,33,24,.06);\n  }\n  @media (prefers-color-scheme: dark){\n    :root:not([data-theme=\"light\"]){\n      --paper:#1C1915;\n      --card:#26221D;\n      --ink:#EFE9DF;\n      --ink-soft:#B5AB9C;\n      --line:#3B352C;\n      --brass:#D3A445;\n      --brass-soft:#3A3122;\n      --blue:#7FA3D6;\n      --shadow:0 1px 3px rgba(0,0,0,.4), 0 6px 18px rgba(0,0,0,.3);\n    }\n  }\n  :root[data-theme=\"dark\"]{\n    --paper:#1C1915;\n    --card:#26221D;\n    --ink:#EFE9DF;\n    --ink-soft:#B5AB9C;\n    --line:#3B352C;\n    --brass:#D3A445;\n    --brass-soft:#3A3122;\n    --blue:#7FA3D6;\n    --shadow:0 1px 3px rgba(0,0,0,.4), 0 6px 18px rgba(0,0,0,.3);\n  }\n  *{box-sizing:border-box}\n  .cm-wrap{\n    margin:0 -1000px;\n    padding:0 1000px;\n    background:var(--paper);\n    color:var(--ink);\n    font-family:'Karla',system-ui,sans-serif;\n    font-size:16px;\n    line-height:1.6;\n  }\n  .wrap{max-width:920px;margin:0 auto;padding:48px 24px 96px}\n  .wrap h1,.wrap h2{font-family:'Marcellus','Times New Roman',serif;font-weight:400;text-wrap:balance;margin:0}\n  .wrap h1{font-size:clamp(34px,6vw,52px);line-height:1.1;letter-spacing:.01em}\n  .wrap h2{font-size:26px;margin-bottom:6px}\n  .eyebrow{\n    text-transform:uppercase;letter-spacing:.18em;font-size:12px;font-weight:700;\n    color:var(--brass);margin-bottom:10px;\n  }\n  .lede{color:var(--ink-soft);max-width:58ch;margin-top:14px}\n  header.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:36px;align-items:center;margin-bottom:24px}\n  @media(max-width:640px){header.hero{grid-template-columns:1fr} }\n  .wrap img{max-width:100%;display:block}\n  .photo{border-radius:12px;box-shadow:var(--shadow);width:100%;height:auto}\n  .wrap section{margin-top:56px;padding-top:40px;border-top:1px solid var(--line)}\n  .sub{color:var(--ink-soft);max-width:60ch;margin-top:4px}\n  /* material cards */\n  .duo{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}\n  @media(max-width:560px){.duo{grid-template-columns:1fr} }\n  .card{\n    background:var(--card);border:1px solid var(--line);border-radius:12px;\n    overflow:hidden;box-shadow:var(--shadow);\n  }\n  .card .pad{padding:18px 20px 20px}\n  .card h3{font-family:'Marcellus',serif;font-weight:400;font-size:20px;margin:0 0 6px}\n  .card p{margin:0;color:var(--ink-soft);font-size:15px}\n  .card img{width:100%;aspect-ratio:1;object-fit:cover}\n  .tagline{display:inline-block;background:var(--brass-soft);color:var(--brass);border-radius:999px;\n    padding:1px 12px;font-size:12.5px;font-weight:700;margin-bottom:8px}\n  /* size row */\n  .sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:28px}\n  @media(max-width:720px){.sizes{grid-template-columns:repeat(2,1fr)} }\n  .size-cell{\n    background:var(--card);border:1px solid var(--line);border-radius:12px;\n    overflow:hidden;text-align:center;box-shadow:var(--shadow);padding-bottom:14px;\n  }\n  .size-cell img{width:100%;aspect-ratio:1;object-fit:cover;margin-bottom:10px}\n  .size-name{font-family:'Marcellus',serif;font-size:22px}\n  .size-price{font-variant-numeric:tabular-nums;font-size:14.5px;margin-top:4px}\n  .size-price b{color:var(--brass);font-weight:700}\n  .size-price .m{color:var(--ink-soft);font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.08em}\n  /* colours */\n  .finishes{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:28px}\n  @media(max-width:720px){.finishes{grid-template-columns:repeat(2,1fr)} }\n  .finish{\n    background:var(--card);border:1px solid var(--line);border-radius:12px;\n    overflow:hidden;text-align:center;box-shadow:var(--shadow);padding-bottom:12px;\n  }\n  .finish img{width:100%;aspect-ratio:1;object-fit:cover;margin-bottom:8px}\n  .finish-name{font-size:14px;font-weight:700}\n  .pill{\n    display:inline-block;background:var(--brass-soft);color:var(--brass);\n    border-radius:999px;padding:3px 14px;font-size:13px;font-weight:700;\n    letter-spacing:.04em;margin-top:18px;\n  }\n  /* branding */\n  .brand-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:26px}\n  @media(max-width:640px){.brand-photos{grid-template-columns:1fr} }\n  .bp{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:var(--shadow)}\n  .bp img{width:100%;aspect-ratio:1;object-fit:cover}\n  .bp .cap{padding:10px 14px;font-size:13.5px;font-weight:700;text-align:center}\n  table{width:100%;border-collapse:collapse;margin-top:24px;font-size:15px}\n  th{\n    text-align:left;text-transform:uppercase;letter-spacing:.1em;font-size:11.5px;\n    color:var(--ink-soft);padding:10px 12px;border-bottom:2px solid var(--line);\n  }\n  td{padding:14px 12px;border-bottom:1px solid var(--line);vertical-align:top}\n  td.num{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:700}\n  td.num.add{color:var(--brass)}\n  .moq{display:inline-block;font-size:12px;font-weight:700;border-radius:999px;padding:1px 10px;white-space:nowrap}\n  .moq.none{background:var(--brass-soft);color:var(--brass)}\n  .moq.some{background:transparent;border:1px solid var(--line);color:var(--ink-soft)}\n  .opt-name{font-weight:700}\n  .opt-desc{color:var(--ink-soft);font-size:13.5px;margin-top:2px}\n  .table-scroll{overflow-x:auto}\n  /* straps */\n  .straps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:26px}\n  @media(max-width:640px){.straps{grid-template-columns:1fr} }\n  .strap-price{color:var(--brass);font-weight:700;margin-top:6px}\n  .ribbon-designs{margin-top:26px}\n  .ribbon-designs img{border-radius:12px;box-shadow:var(--shadow)}\n  .ribbon-designs p{color:var(--ink-soft);font-size:14px;margin:10px 0 0}\n  /* gst */\n  .gst{\n    margin-top:56px;background:var(--card);border:1px solid var(--line);border-radius:12px;\n    padding:22px 24px;display:flex;gap:16px;align-items:baseline;box-shadow:var(--shadow);\n  }\n  .gst b{font-family:'Marcellus',serif;font-weight:400;font-size:22px;color:var(--brass);white-space:nowrap}\n  .gst span{color:var(--ink-soft);font-size:15px}\n  footer{margin-top:64px;color:var(--ink-soft);font-size:13px;border-top:1px solid var(--line);padding-top:20px}\n</style>\n\n<div class=\"cm-wrap\"><div class=\"wrap\">\n\n<header class=\"hero\">\n  <div>\n    <div class=\"eyebrow\">Meru Trophy \u00b7 Medal Catalogue</div>\n    <h1>Classic Medal</h1>\n    <p class=\"lede\">A classic round medal with a raised rim and a completely plain face on both\n    sides \u2014 no embossed pattern, no cast design. The blank face is the point: it takes foil\n    stickers, UV printing, or engraving cleanly, or ships plain as a simple, honest award.</p>\n  </div>\n  <img class=\"photo\" src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-hero.jpg?v=1787948008\" alt=\"Plain gold medal with raised rim on a royal blue neck ribbon\">\n</header>\n\n<!-- MATERIAL -->\n<section>\n  <div class=\"eyebrow\">01 \u00b7 Material</div>\n  <h2>Iron or zinc</h2>\n  <p class=\"sub\">The same plain-face, rimmed shape is made in two base metals. Both take the\n  same finishes and branding options \u2014 zinc is priced at double the iron base price.</p>\n  <div class=\"duo\">\n    <div class=\"card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-iron.jpg?v=1787948008\" alt=\"Stamped iron medal with plain polished face\">\n      <div class=\"pad\">\n        <span class=\"tagline\">Base price</span>\n        <h3>Iron</h3>\n        <p>The economical workhorse. Stamped iron body with electroplated finish and a solid,\n        weighty feel \u2014 ideal for large batches at school and community events.</p>\n      </div>\n    </div>\n    <div class=\"card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-zinc.jpg?v=1787948007\" alt=\"Die-cast zinc alloy medal with bright mirror finish\">\n      <div class=\"pad\">\n        <span class=\"tagline\">2\u00d7 iron price</span>\n        <h3>Zinc</h3>\n        <p>Die-cast zinc alloy. Lighter in the hand and noticeably shinier, with a brighter\n        mirror finish, crisper rim edges, and a smoother face for engraving and UV printing.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- SIZES -->\n<section>\n  <div class=\"eyebrow\">02 \u00b7 Sizes &amp; Prices</div>\n  <h2>Four sizes, shown on a palm</h2>\n  <p class=\"sub\">Diameter is measured across the face, rim included. Prices are per medal for\n  the plain finish \u2014 iron at base price, zinc at double.</p>\n  <div class=\"sizes\">\n    <div class=\"size-cell\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-palm2.jpg?v=1787948008\" alt=\"2 inch medal held on an open palm\">\n      <div class=\"size-name\">2\"</div>\n      <div class=\"size-price\"><span class=\"m\">Iron</span> <b>\u20b915</b> \u00b7 <span class=\"m\">Zinc</span> <b>\u20b930</b></div>\n    </div>\n    <div class=\"size-cell\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-palm25.jpg?v=1787948008\" alt=\"2.5 inch medal held on an open palm\">\n      <div class=\"size-name\">2.5\"</div>\n      <div class=\"size-price\"><span class=\"m\">Iron</span> <b>\u20b925</b> \u00b7 <span class=\"m\">Zinc</span> <b>\u20b950</b></div>\n    </div>\n    <div class=\"size-cell\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-palm3.jpg?v=1787948008\" alt=\"3 inch medal held on an open palm\">\n      <div class=\"size-name\">3\"</div>\n      <div class=\"size-price\"><span class=\"m\">Iron</span> <b>\u20b950</b> \u00b7 <span class=\"m\">Zinc</span> <b>\u20b9100</b></div>\n    </div>\n    <div class=\"size-cell\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-palm35.jpg?v=1787948008\" alt=\"3.5 inch medal larger than the palm holding it\">\n      <div class=\"size-name\">3.5\"</div>\n      <div class=\"size-price\"><span class=\"m\">Iron</span> <b>\u20b980</b> \u00b7 <span class=\"m\">Zinc</span> <b>\u20b9160</b></div>\n    </div>\n  </div>\n</section>\n\n<!-- COLOURS -->\n<section>\n  <div class=\"eyebrow\">03 \u00b7 Base Colours</div>\n  <h2>Eight finishes, one price</h2>\n  <p class=\"sub\">Every finish costs the same \u2014 pick by event, not by budget. Bright finishes are\n  mirror-polished; antique finishes have a darker, matte aged patina.</p>\n  <div class=\"finishes\">\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-gold.jpg?v=1787948007\" alt=\"Gold finish plain medal\"><div class=\"finish-name\">Gold</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-silver.jpg?v=1787948008\" alt=\"Silver finish plain medal\"><div class=\"finish-name\">Silver</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-bronze.jpg?v=1787948008\" alt=\"Bronze finish plain medal\"><div class=\"finish-name\">Bronze</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-brown.jpg?v=1787948008\" alt=\"Brown finish plain medal\"><div class=\"finish-name\">Brown</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-agold.jpg?v=1787948007\" alt=\"Antique gold finish plain medal\"><div class=\"finish-name\">Antique Gold</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-asilver.jpg?v=1787948007\" alt=\"Antique silver finish plain medal\"><div class=\"finish-name\">Antique Silver</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-abronze.jpg?v=1787948008\" alt=\"Antique bronze finish plain medal\"><div class=\"finish-name\">Antique Bronze</div></div>\n    <div class=\"finish\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-f-abrown.jpg?v=1787948007\" alt=\"Antique brown finish plain medal\"><div class=\"finish-name\">Antique Brown</div></div>\n  </div>\n  <span class=\"pill\">All eight finishes \u2014 same price</span>\n</section>\n\n<!-- BRANDING -->\n<section>\n  <div class=\"eyebrow\">04 \u00b7 Branding Options</div>\n  <h2>From plain to fully custom</h2>\n  <p class=\"sub\">The plain face is the canvas. Add-on price is per medal, on top of the base\n  size price. MOQ is the minimum order quantity for that option.</p>\n  <div class=\"brand-photos\">\n    <div class=\"bp\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-b-foil.jpg?v=1787948007\" alt=\"Full-face golden foil WINNER sticker on medal\"><div class=\"cap\">Golden foil sticker</div></div>\n    <div class=\"bp\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-b-uv.jpg?v=1787948007\" alt=\"Full colour UV printed design on medal face\"><div class=\"cap\">UV printing</div></div>\n    <div class=\"bp\"><img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-b-engrave.jpg?v=1787948008\" alt=\"Text engraved into the medal face\"><div class=\"cap\">Engraving</div></div>\n  </div>\n  <div class=\"table-scroll\">\n  <table>\n    <thead>\n      <tr><th>Option</th><th>MOQ</th><th>Add-on</th></tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td><div class=\"opt-name\">Plain \u2014 no branding</div>\n            <div class=\"opt-desc\">Blank polished face, both sides. Ready to hand out as-is.</div></td>\n        <td><span class=\"moq none\">No MOQ</span></td>\n        <td class=\"num\">+\u20b90</td>\n      </tr>\n      <tr>\n        <td><div class=\"opt-name\">Golden foil sticker, standard design</div>\n            <div class=\"opt-desc\">Full-face golden foil with OHP lamination. Stock designs: WINNER, RUNNER, and curve patterns.</div></td>\n        <td><span class=\"moq none\">No MOQ</span></td>\n        <td class=\"num add\">+\u20b910</td>\n      </tr>\n      <tr>\n        <td><div class=\"opt-name\">Custom foil sticker</div>\n            <div class=\"opt-desc\">Same foil and OHP lamination, printed with your own brand or event design.</div></td>\n        <td><span class=\"moq some\">20 pcs</span></td>\n        <td class=\"num add\">+\u20b920</td>\n      </tr>\n      <tr>\n        <td><div class=\"opt-name\">Standard UV printing</div>\n            <div class=\"opt-desc\">Full-colour UV print directly on the metal face, from our standard design library.</div></td>\n        <td><span class=\"moq some\">20 pcs</span></td>\n        <td class=\"num add\">+\u20b920</td>\n      </tr>\n      <tr>\n        <td><div class=\"opt-name\">Custom UV printing</div>\n            <div class=\"opt-desc\">Full-colour UV print of your own artwork \u2014 logos, multilingual text, photos.</div></td>\n        <td><span class=\"moq some\">50 pcs</span></td>\n        <td class=\"num add\">+\u20b925</td>\n      </tr>\n      <tr>\n        <td><div class=\"opt-name\">Custom engraving</div>\n            <div class=\"opt-desc\">Text engraved into the metal \u2014 event name, recipient name, city, date. Permanent and premium.</div></td>\n        <td><span class=\"moq some\">100 pcs</span></td>\n        <td class=\"num add\">+\u20b930</td>\n      </tr>\n    </tbody>\n  </table>\n  </div>\n</section>\n\n<!-- STRAPS -->\n<section>\n  <div class=\"eyebrow\">05 \u00b7 Strap &amp; Tag</div>\n  <h2>Strap materials</h2>\n  <p class=\"sub\">Every medal ships with a neck strap. Cloth is included; satin and lanyard are\n  upgrades, priced per medal.</p>\n  <div class=\"straps\">\n    <div class=\"card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-strap-cloth.jpg?v=1787948008\" alt=\"Woven cloth grosgrain ribbon on a gold medal\">\n      <div class=\"pad\">\n        <h3>Cloth</h3>\n        <p>Standard woven grosgrain ribbon with a matte, ribbed texture. Sturdy and\n        everyday \u2014 the default choice for bulk events.</p>\n        <div class=\"strap-price\">Free</div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-strap-satin.jpg?v=1787948008\" alt=\"Glossy satin ribbon on a gold medal\">\n      <div class=\"pad\">\n        <h3>Satin</h3>\n        <p>Smooth and glossy with a soft drape \u2014 feels premium around the neck and\n        photographs beautifully on the podium.</p>\n        <div class=\"strap-price\">+\u20b925</div>\n      </div>\n    </div>\n    <div class=\"card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-strap-lanyard.jpg?v=1787948007\" alt=\"Flat lanyard with metal clip on a gold medal\">\n      <div class=\"pad\">\n        <h3>Lanyard</h3>\n        <p>Flat woven polyester with a metal swivel clip \u2014 the medal detaches, and the\n        lanyard can be printed and reused like an ID strap.</p>\n        <div class=\"strap-price\">+\u20b925</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"ribbon-designs\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0893/7960/2706/files/classic-medal-ribbons.jpg?v=1787948008\" alt=\"Red, yellow, blue, tricolor and dual-color medal ribbons laid side by side\">\n    <p><b>Designs:</b> plain red, yellow, or blue \u00b7 tricolor \u00b7 dual color</p>\n  </div>\n</section>\n\n<!-- GST -->\n<div class=\"gst\">\n  <b>+ 5% GST</b>\n  <span>All prices above are before tax. GST at 5% applies on the final billed amount \u2014\n  base medal, branding add-ons, and strap upgrades included.</span>\n</div>\n\n<footer>Classic Medal \u00b7 Iron &amp; zinc \u00b7 2\"\u20133.5\" \u00b7 Meru Trophy \u00b7 Photos are AI-generated product renders</footer>\n\n</div></div>"
          }
        }
      },
